// Prisma schema for Annagati
// PostgreSQL Database provided by Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Centre {
  id              String    @id
  name            String
  district        String
  state           String    @default("Haryana")
  address         String?
  distance_km     Decimal?  @db.Decimal(5, 2)
  lat             Decimal?  @db.Decimal(9, 6)
  lng             Decimal?  @db.Decimal(9, 6)
  operating_hours String?   @default("08:00 AM - 06:00 PM")
  active_counters Int?      @default(4)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  bookings        Booking[]

  @@map("centres")
}

model Booking {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token                String    @unique
  centre_id            String
  centre               Centre    @relation(fields: [centre_id], references: [id], onDelete: Restrict)
  farmer_name          String
  mobile               String?
  aadhaar_last4        String?   @default("4821")
  crop_name            String
  slot_time            String
  expected_qty         Decimal   @db.Decimal(10, 2)
  status               String    @default("WAITING") // WAITING, CHECKED_IN, PROCESSING, COMPLETED, CANCELLED, DRYING_REQUIRED, NO_SHOW
  booking_type         String?   @default("ONLINE") // ONLINE, ASSISTED, WALK_IN
  counter              String?   @default("Counter 2")
  actual_qty           Decimal?  @db.Decimal(10, 2)
  moisture_percent     Decimal?  @db.Decimal(5, 2)
  quality_grade        String?
  quality_parameters   Json?
  rate_per_quintal     Decimal?  @default(2200) @db.Decimal(10, 2)
  total_payout         Decimal?  @db.Decimal(12, 2)
  payment_status       String?   @default("PENDING") // PENDING, PENDING_DISBURSAL, DISBURSED
  dbt_reference        String?
  arrival_time         DateTime? @db.Timestamptz(6)
  est_time             DateTime? @db.Timestamptz(6)
  suspended_at         DateTime? @db.Timestamptz(6)
  drying_yard_location String?
  freight_subsidy      Decimal?  @default(0) @db.Decimal(10, 2)
  rerouted_from        String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  @@map("bookings")
}

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String   @unique
  password         String?
  full_name        String
  role             String   @default("farmer") // farmer, operator, admin
  operator_channel String?  @default("online") // online, physical
  phone            String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@map("users")
}
